# Written in the first commit, not the tenth. On the previous project a
# `git add -A` during a release swept a local scratch folder into the same
# commit as the privacy policy, because nothing was ignoring it.

# Build output and packages
/dist/
/build/
*.zip

# Private key for a packed .crx. Losing control of this means losing control
# of the extension ID.
*.pem

# Local working files
/scratch/
/notes/
*.local.*
# The Claude desktop app writes files it hands back into this folder. On
# 2026-09-14 a `git add -A` swept it into a commit, putting a second copy of
# site/index.html in the repository, which is the exact thing the note at the
# top of this file was written about after it happened on the previous project.
/Claude outputs/

# Environment
.env
.env.*

# Dependencies, should any ever appear
node_modules/

# Editor and OS
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp
